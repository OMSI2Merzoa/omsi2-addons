{
  "notices": [
    {
      "title": "\uB2E4\uC6B4\uB85C\uB4DC \uC624\uB958\uAC00 \uB728\uBA74 \uC774\uB807\uAC8C \uD574\uC8FC\uC138\uC694",
      "date": "2026-11-08",
      "body": "\uC124\uCE58\uAC00 \uBA48\uCDC4\uB2E4\uBA74 \uB85C\uADF8\uC5D0 \uB098\uC628 \uBB38\uAD6C\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694.\r\n\uC624\uB958\uC5D0 \uB530\uB77C \uAE30\uB2E4\uB824\uC57C \uD558\uB294 \uC2DC\uAC04\uC774\uB098 \uD655\uC778\uD560 \uB0B4\uC6A9\uC774 \uB2EC\uB77C\uC694.\r\n\r\n\uC774\uBBF8 \uC774 \uD30C\uC77C\uC744 \uB2E4\uC6B4\uB85C\uB4DC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4 - \uC9C4\uD589 \uC911\uC778 \uB2E4\uC6B4\uB85C\uB4DC\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694.\r\n\r\n\uAC19\uC740 \uD30C\uC77C\uC758 \uBC18\uBCF5 \uB2E4\uC6B4\uB85C\uB4DC\uB97C \uC7A0\uC2DC \uC81C\uD55C\uD588\uC2B5\uB2C8\uB2E4 - \uB85C\uADF8\uC5D0 \uB098\uC628 \uB0A8\uC740 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694. \uBCF4\uD1B5 \uC774\uC804 \uB2E4\uC6B4\uB85C\uB4DC \uC2DC\uB3C4\uAC00 \uB05D\uB09C \uB4A4 1\uBD84\uC744 \uAE30\uB2E4\uB9AC\uBA74 \uB429\uB2C8\uB2E4.\r\n\r\nGoogle Drive\uC758 \uB2E4\uC6B4\uB85C\uB4DC \uD55C\uB3C4\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4 - \uD234\uBC15\uC2A4\uC5D0\uC11C \uAC19\uC740 \uD30C\uC77C\uC744 \uB2E4\uC2DC \uC694\uCCAD\uD558\uB824\uBA74 15\uBD84\uC744 \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694. \uADF8 \uB4A4\uC5D0\uB3C4 \uAC19\uC740 \uC624\uB958\uAC00 \uB728\uBA74 Google Drive\uC758 \uC81C\uD55C\uC774 \uC544\uC9C1 \uD480\uB9AC\uC9C0 \uC54A\uC740 \uAC70\uC608\uC694.\r\n\r\n\uB2E4\uC6B4\uB85C\uB4DC \uC11C\uBC84\uAC00 \uD30C\uC77C \uB300\uC2E0 \uC6F9\uD398\uC774\uC9C0\uB098 \uC548\uB0B4 \uC751\uB2F5\uC744 \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4 - \uACF5\uC720 \uB9C1\uD06C\uAC00 \uB85C\uADF8\uC778\uC774\uB098 \uD655\uC778 \uD654\uBA74\uC73C\uB85C \uC5F4\uB9B4 \uB54C \uC774\uB7F0 \uC624\uB958\uAC00 \uB0A0 \uC218 \uC788\uC5B4\uC694. \uAC19\uC740 \uC624\uB958\uAC00 \uBC18\uBCF5\uB418\uBA74 \uC81C\uC791\uC790\uC5D0\uAC8C \uD30C\uC77C \uC774\uB984\uACFC \uC624\uB958 \uBB38\uAD6C\uB97C \uC54C\uB824 \uC8FC\uC138\uC694.\r\n\r\n\uB2E4\uC6B4\uB85C\uB4DC \uC11C\uBC84\uAC00 \uC81C\uC2DC\uAC04\uC5D0 \uC751\uB2F5\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4 (HTTP 504) - \uD30C\uC77C\uC744 \uBCF4\uB0B4\uB294 \uC11C\uBC84\uC758 \uC751\uB2F5\uC774 \uB2A6\uC5B4\uC9C4 \uACBD\uC6B0\uC608\uC694. \uC7A0\uC2DC \uAE30\uB2E4\uB838\uB2E4\uAC00 \uB2E4\uC2DC \uC124\uCE58\uD574 \uC8FC\uC138\uC694. \uAC19\uC740 \uD30C\uC77C\uC5D0\uC11C \uACC4\uC18D \uB728\uBA74 \uC560\uB4DC\uC628 \uC774\uB984\uACFC \uC624\uB958 \uBB38\uAD6C\uB97C \uD568\uAED8 \uC81C\uBCF4\uD574 \uC8FC\uC138\uC694.\r\n\r\n\uD30C\uC77C\uC744 \uBC1B\uB294 \uB3C4\uC911\uC5D0 \uBA48\uCDC4\uB2E4\uBA74, \uC774\uBBF8 \uB2E4 \uBC1B\uC740 \uD30C\uC77C\uC740 \uCD5C\uB300 24\uC2DC\uAC04 \uB3D9\uC548 \uC7AC\uC0AC\uC6A9\uD560 \uC218 \uC788\uC5B4\uC694. \uC81C\uC791\uC790\uAC00 \uBCF4\uC870 \uB2E4\uC6B4\uB85C\uB4DC \uC8FC\uC18C\uB97C \uB4F1\uB85D\uD574 \uB480\uB2E4\uBA74 \uD234\uBC15\uC2A4\uAC00 \uADF8 \uC8FC\uC18C\uB85C\uB3C4 \uBC1B\uC544 \uBD05\uB2C8\uB2E4.",
      "pinned": true
    },
    {
      "title": "OMSI \uD234\uBC15\uC2A4 V1.1.2.0 \uAE34\uAE09 \uC5C5\uB370\uC774\uD2B8 \uC548\uB0B4",
      "date": "2026-11-06",
      "body": "\u25CF \uC555\uCD95 \uD574\uC81C\uB41C \uD30C\uC77C\uC758 \uC77D\uAE30 \uC804\uC6A9 \uC18D\uC131\uC73C\uB85C \uC124\uCE58\uAC00 \uC911\uB2E8\uB418\uB294 \uC624\uB958 \uC218\uC815\n\u25CF \uC77D\uAE30 \uC804\uC6A9 \uC784\uC2DC \uD30C\uC77C\uC774 \uC0AD\uC81C\uB418\uC9C0 \uC54A\uB294 \uBB38\uC81C \uC218\uC815\r\n\r\n\uBA87\uAC1C\uC758 \uC560\uB4DC\uC628\uC774 \uC815\uC0C1\uC124\uCE58\uB418\uC9C0 \uC54A\uB294 \uBB38\uC81C\uB97C \uD574\uACB0\uD588\uC2B5\uB2C8\uB2E4."
    },
    {
      "title": "OMSI \uD234\uBC15\uC2A4 V1.1.1.0 \uC5C5\uB370\uC774\uD2B8 \uC548\uB0B4",
      "date": "2026-11-04",
      "body": "\uD558\uB8E8\uB9CC\uC5D0 \uC0C8\uB85C\uC6B4 \uBC84\uC804\uC73C\uB85C \uC778\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4.\r\n\uC774\uBC88 \uBC84\uC804\uC5D0\uC11C\uB294 \uC544\uB798\uC758 \uAE30\uB2A5\uB4E4\uC774 \uCD94\uAC00 \uBC0F \uAC1C\uC120\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\u25CF \uC81C\uC791\uC790 \uC0AC\uC774\uD2B8 \uAC1C\uC124: \uB9F5\u00B7\uBC84\uC2A4\u00B7AI \uCC28\uB7C9\u00B7\uB3C4\uC0C9 \uC9C1\uC811 \uB4F1\uB85D \uBC0F \uAD00\uB9AC\n\u25CF \uD558\uB098\uC758 \uAC1C\uBC1C\uC790 \uACC4\uC815\uC73C\uB85C \uC560\uB4DC\uC628\uACFC \uB3C4\uC0C9 \uD1B5\uD569 \uAD00\uB9AC\n\u25CF \uC560\uB4DC\uC628\uAC1C\uBC1C\uC790\uAC00 \uB4F1\uB85D\uD55C \uC560\uB4DC\uC628\uC744 \uD234\uBC15\uC2A4\uC5D0\uC11C \uB2E4\uC6B4\uB85C\uB4DC\u00B7\uC124\uCE58\n\u25CF \uAD6C\uC131\uC694\uC18C\uBCC4 \uBC30\uD3EC \uC790\uB8CC\uC758 \uC120\uD0DD \uB2E4\uC6B4\uB85C\uB4DC \uC9C0\uC6D0\n\u25CF \uCEE4\uBBA4\uB2C8\uD2F0 \uB3C4\uC0C9 \uAC80\uC0C9\u00B7\uCC28\uB7C9\uBCC4 \uBCF4\uAE30\u00B7\uC790\uB3D9 \uC124\uCE58 \uAE30\uB2A5 \uCD94\uAC00\n\u25CF \uC560\uB4DC\uC628 \uC6B0\uCE21 \uC0C1\uC138\uCC3D, \uC218\uB3D9 \uC124\uCE58 \uD45C\uC2DC, AI \uCC28\uB7C9 \uC81C\uC870\uC0AC \uD544\uD130 \uCD94\uAC00\n\u25CF \uC124\uCE58 \uC9C4\uD589\uB960\u00B7\uC791\uC5C5 \uB2E8\uACC4 \uD45C\uC2DC \uBC0F \uB85C\uADF8 \uAC1C\uC120\n\u25CF \uB300\uC6A9\uB7C9 \uC124\uCE58\u00B7\uB9F5 \uC9C4\uB2E8\u00B7\uAC80\uC0C9 \uC131\uB2A5\uACFC \uCDE8\uC18C\u00B7\uC5C5\uB370\uC774\uD2B8 \uC548\uC815\uC131 \uAC1C\uC120\n\u25CF .NET \uC2E4\uD589 \uD658\uACBD \uD3EC\uD568 \uBC30\uD3EC\uB85C \uBCC4\uB3C4 \uC124\uCE58 \uC5C6\uC774 \uC2E4\uD589 \uAC00\uB2A5"
    },
    {
      "title": "OMSI \uC560\uB4DC\uC628 \uD234\uBC15\uC2A4",
      "date": "2026-11-03",
      "body": "OMSI 2 \uD1B5\uD569\uBAA8\uB4DC \uD234\uBC15\uC2A4\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4!\n\n\uD234\uBC15\uC2A4\uC5D0\uC11C\uB294 \uC560\uB4DC\uC628 \uC124\uCE58, \uB9F5 \uB204\uB77D \uB9AC\uC18C\uC2A4 \uC9C4\uB2E8, AI \uB9AC\uC2A4\uD2B8 \uD3B8\uC9D1 \uAE30\uB2A5\uC744 \uC774\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC774\uC6A9 \uC804 \uC124\uC815\uC5D0\uC11C OMSI 2 \uC124\uCE58 \uACBD\uB85C\uB97C \uD655\uC778\uD574 \uC8FC\uC138\uC694. \uC560\uB4DC\uC628 \uC124\uCE58\uB098 \uD30C\uC77C \uD3B8\uC9D1\uC740 \uAC8C\uC784\uC744 \uC885\uB8CC\uD55C \uC0C1\uD0DC\uC5D0\uC11C \uC9C4\uD589\uD558\uACE0, \uC911\uC694\uD55C \uD30C\uC77C\uC740 \uBCC4\uB3C4\uB85C \uBC31\uC5C5\uD574 \uB450\uB294 \uAC83\uC744 \uAD8C\uC7A5\uD569\uB2C8\uB2E4.\n\n\uB9F5 \uC9C4\uB2E8\uC5D0\uC11C \uCD94\uCC9C\uD558\uB294 \uC560\uB4DC\uC628\uC740 \uB204\uB77D \uB9AC\uC18C\uC2A4 \uC815\uBCF4\uB97C \uAE30\uC900\uC73C\uB85C \uC81C\uACF5\uB429\uB2C8\uB2E4. \uC124\uCE58 \uD6C4\uC5D0\uB3C4 \uBB38\uC81C\uAC00 \uB0A8\uC544 \uC788\uB2E4\uBA74 \uD574\uB2F9 \uC790\uB8CC\uC758 \uC124\uCE58 \uC548\uB0B4\uC640 \uD544\uC218 \uC560\uB4DC\uC628\uC744 \uD568\uAED8 \uD655\uC778\uD574 \uC8FC\uC138\uC694.\n\n\uC55E\uC73C\uB85C \uC5C5\uB370\uC774\uD2B8\uC640 \uC8FC\uC694 \uC548\uB0B4\uC0AC\uD56D\uC740 \uC774\uACF3\uC5D0 \uACF5\uC9C0\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC990\uAC70\uC6B4 \uC6B4\uD589 \uB418\uC138\uC694!",
      "pinned": true
    }
  ]
}